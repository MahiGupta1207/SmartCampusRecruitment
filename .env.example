# =====================================================================
# CampusHire - Environment Configuration
# =====================================================================
# For live Supabase integration, create a free project at https://supabase.com
# Then paste your Project URL and anon public key below:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Note: If these keys are not set, CampusHire automatically operates in
# local evaluation mode with realistic seed data and full functionality!
